# Sao chép file này thành .env (chạy trên máy) hoặc nhập từng dòng vào phần Environment của hosting.

# Chuỗi kết nối MongoDB. Trên máy: mongodb://127.0.0.1:27017/nomnomfood
# Trên mạng: chuỗi lấy từ MongoDB Atlas, dạng mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/nomnomfood
MONGODB_URI=mongodb://127.0.0.1:27017/nomnomfood

# Chuỗi bí mật để ký token đăng nhập — một chuỗi ngẫu nhiên dài, không chia sẻ cho ai
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-that-dai

# Khóa API Groq cho chatbot NomBot
GROQ_API_KEY=

# Địa chỉ website khi đã đưa lên mạng (dùng cho sitemap và thẻ SEO), ví dụ https://nomnomfood.onrender.com
SITE_URL=

# Mã xác minh Google Search Console (phương thức "Thẻ HTML": chỉ lấy phần content="...")
GOOGLE_SITE_VERIFICATION=

NODE_ENV=production
